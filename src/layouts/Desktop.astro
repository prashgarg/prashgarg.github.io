---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'Prashant Garg', description = "Personal site of Prashant Garg, economist." } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const ogPath = path === '/' ? '/og/index.png' : `/og${path}.png`;
const ogImageUrl = Astro.site ? new URL(ogPath, Astro.site).toString() : ogPath;
const canonical  = Astro.site ? new URL(path, Astro.site).toString() : path;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="min-h-screen overflow-hidden">
    <!-- Subtle animated network motif behind the desktop -->
    <svg class="desk-graph" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g class="g-edges" stroke="#14110D" stroke-opacity="0.45" stroke-width="0.7" fill="none" stroke-linecap="round">
        <line x1="120" y1="120" x2="320" y2="200"/>
        <line x1="320" y1="200" x2="540" y2="160"/>
        <line x1="540" y1="160" x2="760" y2="240"/>
        <line x1="760" y1="240" x2="980" y2="180"/>
        <line x1="120" y1="120" x2="240" y2="380"/>
        <line x1="240" y1="380" x2="460" y2="440"/>
        <line x1="460" y1="440" x2="640" y2="360"/>
        <line x1="640" y1="360" x2="820" y2="500"/>
        <line x1="820" y1="500" x2="1040" y2="420"/>
        <line x1="240" y1="380" x2="320" y2="200"/>
        <line x1="460" y1="440" x2="540" y2="160"/>
        <line x1="640" y1="360" x2="760" y2="240"/>
        <line x1="180" y1="640" x2="380" y2="580"/>
        <line x1="380" y1="580" x2="560" y2="660"/>
        <line x1="560" y1="660" x2="760" y2="600"/>
        <line x1="760" y1="600" x2="940" y2="680"/>
        <line x1="380" y1="580" x2="460" y2="440"/>
        <line x1="560" y1="660" x2="640" y2="360"/>
        <line x1="940" y1="680" x2="1040" y2="420"/>
      </g>
      <g class="g-nodes" fill="#14110D">
        <circle cx="120"  cy="120" r="3"/>
        <circle cx="320"  cy="200" r="3"/>
        <circle cx="540"  cy="160" r="3"/>
        <circle cx="760"  cy="240" r="3"/>
        <circle cx="980"  cy="180" r="3"/>
        <circle cx="240"  cy="380" r="3"/>
        <circle cx="460"  cy="440" r="3"/>
        <circle cx="640"  cy="360" r="3"/>
        <circle cx="820"  cy="500" r="3"/>
        <circle cx="1040" cy="420" r="3"/>
        <circle cx="180"  cy="640" r="3"/>
        <circle cx="380"  cy="580" r="3"/>
        <circle cx="560"  cy="660" r="3"/>
        <circle cx="760"  cy="600" r="3"/>
        <circle cx="940"  cy="680" r="3"/>
      </g>
    </svg>

    <slot />

    <style>
      .desk-graph {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
        opacity: 0.12;
        mix-blend-mode: multiply;
      }
      html.dark .desk-graph { opacity: 0.20; mix-blend-mode: screen; }
      html.dark .desk-graph g { stroke: #EEEFE9; fill: #EEEFE9; }
      .desk-graph .g-nodes circle {
        transform-origin: center;
        transform-box: fill-box;
        animation: nodePulse 5.2s ease-in-out infinite;
      }
      .desk-graph .g-nodes circle:nth-child(2n) { animation-delay: -1.6s; }
      .desk-graph .g-nodes circle:nth-child(3n) { animation-delay: -2.8s; }
      .desk-graph .g-nodes circle:nth-child(5n) { animation-delay: -3.4s; }
      .desk-graph .g-edges line {
        stroke-dasharray: 240 80;
        stroke-dashoffset: 0;
        animation: edgeFlow 16s linear infinite;
      }
      .desk-graph .g-edges line:nth-child(2n) { animation-duration: 21s; animation-direction: reverse; }
      .desk-graph .g-edges line:nth-child(3n) { animation-duration: 24s; }
      @keyframes nodePulse {
        0%, 100% { transform: scale(1);   opacity: 1; }
        50%      { transform: scale(1.7); opacity: 0.55; }
      }
      @keyframes edgeFlow {
        0%   { stroke-dashoffset: 0; }
        100% { stroke-dashoffset: -320; }
      }
      @media (prefers-reduced-motion: reduce) {
        .desk-graph .g-nodes circle,
        .desk-graph .g-edges line { animation: none; }
      }
    </style>
  </body>
</html>
