---
import '../styles/global.css';
import { site } from '../data/site';
import PersonJsonLd from '../components/PersonJsonLd.astro';
interface Props { title?: string; description?: string }
const { title = 'Prashant Garg — Economist', description = site.tagline } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const ogPath = path === '/' ? '/og/index.png' : `/og${path}.png`;
const ogImageUrl = Astro.site ? new URL(ogPath, Astro.site).toString() : ogPath;
const canonical  = Astro.site ? new URL(path === '/' ? '/' : `${path}/`, Astro.site).toString() : path;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/atom+xml" title="Papers — Prashant Garg" href="/papers.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Prashant Garg" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.twitterHandle} />
    <meta name="twitter:creator" content={site.twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <PersonJsonLd />
    <style>
      html, body { margin: 0; padding: 0; background: #13100B; color: #E8DBB6; overscroll-behavior: none; }
      body { overflow: hidden; }
      /* Server-rendered entry layer: the instant first paint (before the
         ~1MB 3D bundle hydrates), the crawlable content + link graph, and
         the no-JS / no-WebGL fallback. Once <Office> mounts, its opaque
         fixed root (later in the DOM) paints over this. */
      #entry {
        position: fixed; inset: 0;
        display: flex; align-items: center; justify-content: center;
        padding: 7vh 24px; box-sizing: border-box; overflow-y: auto;
        font-family: ui-monospace, 'SF Mono', Menlo, Monaco, Consolas, monospace;
      }
      #entry .ef { max-width: 620px; }
      #entry h1 { font-size: 22px; letter-spacing: 0.02em; margin: 0 0 4px; color: #E8DBB6; font-weight: 600; }
      #entry .ef-tag { font-size: 13px; line-height: 1.5; color: rgba(232,219,182,0.62); margin: 0 0 18px; }
      #entry .ef-bio { font-size: 13.5px; line-height: 1.7; color: rgba(232,219,182,0.88); margin: 0 0 20px; }
      #entry .ef-links { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 0 0 18px; }
      #entry .ef-links a { color: #A4D9C5; text-decoration: none; font-size: 13px; border-bottom: 1px solid rgba(164,217,197,0.38); padding-bottom: 1px; }
      #entry .ef-links a:hover { color: #E8EEDF; border-color: #E8EEDF; }
      #entry .ef-foot { margin: 0; font-size: 13px; }
      #entry .ef-foot a { color: #E8DBB6; }
      /* Always-visible escape hatch to the plain-text version. Sits ON TOP
         of the 3D canvas (the #entry copy gets painted over once Office
         mounts), so an impatient or touch visitor always has a door to the
         content. Bottom-right corner — clear of the bottom-left HUD chips. */
      #text-version {
        position: fixed; right: 14px; bottom: 12px; z-index: 9999;
        font-family: ui-monospace, 'SF Mono', Menlo, monospace;
        font-size: 12px; letter-spacing: 0.04em; color: rgba(232,219,182,0.6);
        text-decoration: none; padding: 4px 9px;
        border: 1px solid rgba(232,219,182,0.18);
        background: rgba(19,16,11,0.38); backdrop-filter: blur(3px);
      }
      #text-version:hover { color: #E8DBB6; border-color: rgba(232,219,182,0.45); }
    </style>
  </head>
  <body>
    <!-- Crawlable, no-JS, instant-paint entry layer (covered by the 3D
         scene once it hydrates). See #entry styles above. -->
    <div id="entry">
      <div class="ef">
        <h1>Prashant Garg</h1>
        <p class="ef-tag">{site.tagline}</p>
        <p class="ef-bio">{site.bio}</p>
        <nav class="ef-links" aria-label="Sections">
          <a href="/research/">Research</a>
          <a href="/talks/">Talks</a>
          <a href="/library/">Library</a>
          <a href="/now/">Now</a>
          <a href="/cv/">CV</a>
          <a href={site.scholar}>Google Scholar</a>
        </nav>
        <p class="ef-foot"><a href="/standard/">Plain-text version →</a></p>
      </div>
    </div>
    <slot />
    <a id="text-version" href="/standard/">Text version →</a>
  </body>
</html>
