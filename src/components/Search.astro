---
// Pagefind-powered search modal (⌘K / Ctrl-K to open)
---
<button id="search-open" aria-label="Search"
        class="hidden sm:inline-flex items-center gap-2 px-2.5 py-1.5 rounded-md border-2 border-ink dark:border-cream bg-white dark:bg-ink-3 text-xs text-ink/60 dark:text-cream/60 hover:bg-cream-dim dark:hover:bg-ink-2 transition-colors shadow-[2px_2px_0_0_var(--color-ink)] dark:shadow-[2px_2px_0_0_var(--color-cream)]">
  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
  <span>Search</span>
  <kbd class="ml-2 px-1.5 py-0.5 rounded border border-ink/20 dark:border-cream/20 text-[10px] font-mono font-bold">⌘K</kbd>
</button>

<button id="search-open-mobile" aria-label="Search"
        class="sm:hidden w-9 h-9 inline-flex items-center justify-center rounded-md border-2 border-ink dark:border-cream bg-white dark:bg-ink-3 shadow-[2px_2px_0_0_var(--color-ink)] dark:shadow-[2px_2px_0_0_var(--color-cream)]">
  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
</button>

<dialog id="search-dialog" class="bg-transparent backdrop:bg-ink/40 backdrop:backdrop-blur-sm">
  <div class="card !p-0 w-[min(92vw,640px)] max-h-[80vh] overflow-hidden flex flex-col">
    <div class="flex items-center gap-2 px-4 py-3 border-b-2 border-ink dark:border-cream">
      <svg class="w-4 h-4 shrink-0 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
      <input id="search-input" type="text" placeholder="Search papers, talks, library..." autocomplete="off"
             class="flex-1 bg-transparent outline-none text-base placeholder:text-ink/40 dark:placeholder:text-cream/40" />
      <kbd class="px-1.5 py-0.5 rounded border border-ink/20 dark:border-cream/20 text-[10px] font-mono font-bold">ESC</kbd>
    </div>
    <div id="search-results" class="flex-1 overflow-y-auto p-3 text-sm">
      <div class="text-ink/50 dark:text-cream/50 text-center py-12">Start typing to search the site.</div>
    </div>
  </div>
</dialog>

<script is:inline>
  let pagefind = null;
  async function ensurePagefind() {
    if (pagefind) return pagefind;
    try {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.options({ excerptLength: 24 });
    } catch (e) {
      pagefind = { search: async () => ({ results: [] }) };
    }
    return pagefind;
  }

  function openSearch() {
    const dlg = document.getElementById('search-dialog');
    if (!dlg) return;
    dlg.showModal();
    const input = document.getElementById('search-input');
    if (input) { input.value = ''; input.focus(); }
    const r = document.getElementById('search-results');
    if (r) r.innerHTML = '<div class="text-ink/50 dark:text-cream/50 text-center py-12">Start typing to search the site.</div>';
  }
  function closeSearch() {
    const dlg = document.getElementById('search-dialog');
    if (dlg && dlg.open) dlg.close();
  }

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openSearch();
    } else if (e.key === 'Escape') {
      closeSearch();
    }
  });
  document.addEventListener('click', (e) => {
    if (e.target.closest('#search-open, #search-open-mobile')) {
      openSearch();
    }
    // click on dialog backdrop
    const dlg = document.getElementById('search-dialog');
    if (dlg && dlg.open && e.target === dlg) closeSearch();
  });
  document.addEventListener('input', async (e) => {
    if (e.target?.id !== 'search-input') return;
    const q = e.target.value.trim();
    const out = document.getElementById('search-results');
    if (!out) return;
    if (!q) {
      out.innerHTML = '<div class="text-ink/50 dark:text-cream/50 text-center py-12">Start typing to search the site.</div>';
      return;
    }
    const pf = await ensurePagefind();
    const { results } = await pf.search(q);
    if (!results.length) {
      out.innerHTML = '<div class="text-ink/50 dark:text-cream/50 text-center py-12">No results for &ldquo;' + q.replace(/[<>&]/g, '') + '&rdquo;.</div>';
      return;
    }
    const top = await Promise.all(results.slice(0, 8).map(r => r.data()));
    out.innerHTML = top.map(d => `
      <a href="${d.url}" class="block px-3 py-2.5 rounded-md hover:bg-brand-yellow/40 border border-transparent hover:border-ink/20 dark:hover:border-cream/20 transition-colors">
        <div class="font-semibold text-ink dark:text-cream">${(d.meta && d.meta.title) || d.url}</div>
        <div class="text-xs text-ink/60 dark:text-cream/60 mt-0.5 line-clamp-2">${d.excerpt}</div>
      </a>
    `).join('');
  });
</script>
