---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t-2 border-ink dark:border-cream bg-cream dark:bg-ink-2">
  <div class="max-w-6xl mx-auto px-4 py-12 grid md:grid-cols-4 gap-8">
    <div class="md:col-span-2">
      <div class="font-display font-bold text-xl">Prashant Garg</div>
      <p class="text-sm text-ink/70 dark:text-cream/70 mt-2 max-w-md">
        {site.tagline}
      </p>
    </div>

    <div>
      <div class="text-xs font-bold uppercase tracking-wider text-ink/50 dark:text-cream/50">Site</div>
      <ul class="mt-2 space-y-1 text-sm">
        <li><a class="hover:underline" href="/research">Research</a></li>
        <li><a class="hover:underline" href="/talks">Talks</a></li>
        <li><a class="hover:underline" href="/library">Library</a></li>
        <li><a class="hover:underline" href="/now">Now</a></li>
      </ul>
    </div>

    <div>
      <div class="text-xs font-bold uppercase tracking-wider text-ink/50 dark:text-cream/50">Elsewhere</div>
      <ul class="mt-2 space-y-1 text-sm">
        <li><a class="hover:underline" href={`mailto:${site.email}`}>Email</a></li>
        <li><a class="hover:underline" href={site.cv} target="_blank" rel="noopener">CV</a></li>
        <li><a class="hover:underline" href={site.scholar} target="_blank" rel="noopener">Google Scholar</a></li>
        <li><a class="hover:underline" href={site.twitter} target="_blank" rel="noopener">Twitter / X</a></li>
        <li><a class="hover:underline" href={site.bluesky} target="_blank" rel="noopener">Bluesky</a></li>
        <li><a class="hover:underline" href={site.github} target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink/20 dark:border-cream/20">
    <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between text-xs text-ink/60 dark:text-cream/60">
      <div>© {year} Prashant Garg. Built with Astro and Tailwind.</div>
      <div>Visual design tips its hat to <a class="underline" href="https://posthog.com" target="_blank" rel="noopener">PostHog</a>.</div>
    </div>
  </div>
</footer>
