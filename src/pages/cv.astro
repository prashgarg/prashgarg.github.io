---
import Layout from '../layouts/Win95Layout.astro';
import { papers, talks, affiliations, site, statusMeta, education, awards, teaching, experience, type PaperStatus } from '../data/site';

// Group papers for CV: published first, then accepted, RR, working, other.
const order: PaperStatus[] = ['published', 'accepted', 'rr', 'working', 'other'];
const grouped = order.map(s => ({
  status: s,
  label: statusMeta[s].label,
  items: papers.filter(p => p.status === s),
})).filter(g => g.items.length > 0);

// Sort talks newest first.
const MONTHS = ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'];
function monthIdx(d: string) {
  const m = d.toLowerCase().match(/\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\b/);
  return m ? MONTHS.indexOf(m[1]) : 6;
}
const talksSorted = [...talks].sort((a, b) =>
  (b.year * 12 + monthIdx(b.date)) - (a.year * 12 + monthIdx(a.date))
);

// Group talks by year for the CV
const talksByYear: Record<number, typeof talksSorted> = {};
for (const t of talksSorted) (talksByYear[t.year] ||= []).push(t);
const years = Object.keys(talksByYear).map(Number).sort((a, b) => b - a);
---
<Layout title="CV — Prashant Garg" current="cv" description="Curriculum vitae — Prashant Garg.">
  <article class="cv-page max-w-4xl mx-auto px-6 pt-10 pb-20">
    <!-- Print-specific actions (hidden on print) -->
    <div class="no-print flex items-center justify-between flex-wrap gap-3 mb-8 pb-4 border-b border-ink/15 dark:border-cream/15">
      <div>
        <h1 class="font-display text-3xl md:text-4xl font-bold tracking-tight">Curriculum Vitae</h1>
      </div>
      <div class="flex items-center gap-2 flex-wrap">
        <button onclick="window.print()" class="inline-flex items-center gap-2 text-sm font-semibold px-3 py-1.5 border-2 border-ink dark:border-cream rounded-md bg-brand-yellow hover:bg-brand-yellow/80">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6z"/></svg>
          Print
        </button>
        <a href="/cv.pdf" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm font-semibold px-3 py-1.5 border-2 border-ink dark:border-cream rounded-md bg-white dark:bg-ink-2 hover:bg-brand-yellow">
          PDF
        </a>
      </div>
    </div>

    <!-- Header (always visible incl. print) -->
    <header class="cv-header mb-8 flex items-start justify-between gap-6">
      <div class="min-w-0">
        <h2 class="cv-name font-display text-4xl md:text-5xl font-bold tracking-tight">{site.name}</h2>
        <p class="cv-tagline mt-2 text-sm md:text-base text-ink/75 dark:text-cream/75 max-w-3xl">{site.tagline}</p>
        <div class="cv-contacts mt-3 text-sm flex flex-wrap items-center gap-x-4 gap-y-1 text-ink/80 dark:text-cream/80">
          <span>{site.email}</span>
          <span class="opacity-50">·</span>
          <span>{site.origin.replace(/^https?:\/\//, '')}</span>
          <span class="opacity-50">·</span>
          <span>{site.twitterHandle}</span>
        </div>
      </div>
      <img src="/photo.jpg" alt="Prashant Garg" class="cv-photo w-24 md:w-28 h-auto shrink-0 border-2 border-ink/20 dark:border-cream/20" />
    </header>

    <!-- EDUCATION -->
    <section class="cv-section mb-8">
      <h3 class="cv-section-title">Education</h3>
      <ul class="cv-list">
        {education.map(e => (
          <li class="cv-entry">
            <div class="cv-row">
              <span class="cv-row-left"><span class="font-semibold">{e.title}</span>{e.org ? ` · ${e.org}` : ''}</span>
              <span class="cv-row-right text-ink/60 dark:text-cream/60">{e.period}</span>
            </div>
            {e.detail && <div class="cv-entry-detail">{e.detail}</div>}
          </li>
        ))}
      </ul>
    </section>

    <!-- AFFILIATIONS -->
    <section class="cv-section mb-8">
      <h3 class="cv-section-title">Affiliations</h3>
      <ul class="cv-list">
        {affiliations.map((a: any) => (
          <li class="cv-row">
            <span class="cv-row-left">
              <span class="font-semibold">{a.role}</span> · {a.org}
            </span>
            <span class="cv-row-right text-ink/60 dark:text-cream/60">
              {a.current ? 'current' : a.incoming ? 'incoming' : 'past'}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <!-- PUBLICATIONS (grouped by status) -->
    <section class="cv-section mb-8">
      <h3 class="cv-section-title">Publications & Working Papers</h3>
      {grouped.map(g => (
        <div class="mb-5">
          <h4 class="cv-subhead">{g.label}</h4>
          <ol class="cv-pub-list">
            {g.items.map(p => (
              <li class="cv-pub">
                <div class="cv-pub-title">{p.title}</div>
                <div class="cv-pub-meta">
                  {p.coauthors.length ? `with ${p.coauthors.join(', ')}` : ''}
                  {p.venue ? ` · ${p.venue}` : ''}
                  {p.year ? ` · ${p.year}` : ''}
                </div>
                {p.award && <div class="cv-pub-award">{p.award.label}</div>}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>

    <!-- AWARDS -->
    <section class="cv-section mb-8">
      <h3 class="cv-section-title">Awards</h3>
      <ul class="cv-list">
        {awards.map(a => (
          <li class="cv-entry">
            <div class="cv-row">
              <span class="cv-row-left"><span class="font-semibold">{a.title}</span>{a.org ? ` · ${a.org}` : ''}</span>
              <span class="cv-row-right text-ink/60 dark:text-cream/60">{a.period}</span>
            </div>
            {a.detail && <div class="cv-entry-detail">{a.detail}</div>}
          </li>
        ))}
      </ul>
    </section>

    <!-- TEACHING -->
    <section class="cv-section mb-8">
      <h3 class="cv-section-title">Teaching</h3>
      <ul class="cv-list">
        {teaching.map(t => (
          <li class="cv-entry">
            <div class="cv-row">
              <span class="cv-row-left"><span class="font-semibold">{t.title}</span>{t.org ? ` · ${t.org}` : ''}</span>
              <span class="cv-row-right text-ink/60 dark:text-cream/60">{t.period}</span>
            </div>
            {t.detail && <div class="cv-entry-detail">{t.detail}</div>}
          </li>
        ))}
      </ul>
    </section>

    <!-- EXPERIENCE -->
    <section class="cv-section mb-8">
      <h3 class="cv-section-title">Experience</h3>
      <ul class="cv-list">
        {experience.map(x => (
          <li class="cv-entry">
            <div class="cv-row">
              <span class="cv-row-left"><span class="font-semibold">{x.title}</span>{x.org ? ` · ${x.org}` : ''}</span>
              <span class="cv-row-right text-ink/60 dark:text-cream/60">{x.period}</span>
            </div>
            {x.detail && <div class="cv-entry-detail">{x.detail}</div>}
          </li>
        ))}
      </ul>
    </section>

    <!-- TALKS (grouped by year) -->
    <section class="cv-section mb-8">
      <h3 class="cv-section-title">Talks</h3>
      {years.map(y => (
        <div class="mb-4">
          <h4 class="cv-subhead">{y}</h4>
          <ul class="cv-talk-list">
            {talksByYear[y].map(t => (
              <li class="cv-talk">
                <span class="cv-talk-date">{t.date}</span>
                <span class="cv-talk-venue">{t.venue}</span>
                <span class="cv-talk-loc"> · {t.location}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <footer class="cv-footer text-xs text-ink/45 dark:text-cream/45 pt-6 border-t border-ink/15 dark:border-cream/15">
      Generated {new Date().toISOString().slice(0, 10)} · {site.origin.replace(/^https?:\/\//, '')}/cv
    </footer>
  </article>

  <!-- CV-specific styles (incl. print) -->
  <style is:global>
    .cv-section-title {
      font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      margin-bottom: 0.75rem;
      padding-bottom: 0.4rem;
      border-bottom: 2px solid currentColor;
    }
    .cv-subhead {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.10em;
      color: rgba(0,0,0,0.55);
      margin: 0.75rem 0 0.4rem;
    }
    .cv-list, .cv-pub-list, .cv-talk-list { list-style: none; padding: 0; margin: 0; }
    .cv-entry { padding: 0.25rem 0; }
    .cv-entry-detail { font-size: 0.82rem; color: rgba(0,0,0,0.60); margin-top: 0.1rem; }
    .cv-pub-award { font-size: 0.82rem; font-style: italic; color: rgba(0,0,0,0.6); margin-top: 0.15rem; }
    .cv-row {
      display: flex; justify-content: space-between; align-items: baseline;
      padding: 0.25rem 0;
      font-size: 0.95rem;
    }
    .cv-row-right { font-size: 0.78rem; }
    .cv-pub { padding: 0.5rem 0; border-top: 1px dotted rgba(0,0,0,0.20); }
    .cv-pub:first-child { border-top: none; }
    .cv-pub-title { font-weight: 600; }
    .cv-pub-meta { font-size: 0.85rem; color: rgba(0,0,0,0.65); margin-top: 0.15rem; }
    .cv-talk { display: flex; gap: 0.75rem; font-size: 0.85rem; padding: 0.15rem 0; }
    .cv-talk-date { font-family: ui-monospace, 'SF Mono', monospace; font-size: 0.72rem; color: rgba(0,0,0,0.55); flex-shrink: 0; width: 90px; }
    .cv-talk-venue { font-weight: 500; }
    .cv-talk-loc { color: rgba(0,0,0,0.55); }

    @media print {
      /* hide all the Win95 chrome — only the CV content prints */
      .w95-titlebar, .w95-menubar, .w95-statusbar, .w95-taskbar,
      .cmdk-hint-btn, .cmdk-backdrop, .theme-toggle, .no-print { display: none !important; }
      .w95-shell { padding: 0 !important; background: #fff !important; }
      .w95-window { box-shadow: none !important; border: none !important; max-width: none !important; max-height: none !important; }
      .w95-body { background: #fff !important; box-shadow: none !important; margin: 0 !important; overflow: visible !important; }
      body, html { height: auto !important; overflow: visible !important; background: #fff !important; }
      .cv-page { padding: 1cm 1.2cm !important; max-width: none !important; }
      .cv-section { page-break-inside: avoid; }
      .cv-pub { page-break-inside: avoid; }
      .cv-section-title { color: #000 !important; border-color: #000 !important; }
      /* force LIGHT even when the dark theme is active — otherwise dark
         backgrounds survive into print and the page is dark-on-dark */
      * { color: #000 !important; background: transparent !important; }
      html, body, .w95-shell, .w95-body, .cv-page { background: #fff !important; }
    }
  </style>
</Layout>
