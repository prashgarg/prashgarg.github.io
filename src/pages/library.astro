---
import Layout from '../layouts/Win95Layout.astro';
import { library, datasets, papers } from '../data/site';

// Dylan essay figures live on the paper entry — interleave them with
// the matching blurb paragraphs (they were written as captions).
const dylanFigures = papers.find(p => p.slug === 'mapping-dylans-mind')?.figures || [];
---
<Layout title="Library — Prashant Garg" current="library">
  <section class="border-b-2 border-ink dark:border-cream">
    <div class="max-w-6xl mx-auto px-4 pt-14 pb-8">
      <h1 class="font-display text-3xl md:text-4xl font-bold">Library</h1>
      <p class="mt-2 text-sm text-ink/55 dark:text-cream/55">{library.length + datasets.length} items · code, open data, and the occasional essay.</p>

      <!-- Search bar -->
      <div class="mt-5 relative max-w-xl">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-ink/40 dark:text-cream/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
        <input
          id="library-search"
          type="text"
          placeholder="Search by title, tag, or text..."
          class="w-full pl-10 pr-10 py-2.5 text-sm border-2 border-ink dark:border-cream rounded-md bg-white dark:bg-ink-2 focus:outline-none focus:bg-brand-yellow/10 placeholder:text-ink/40 dark:placeholder:text-cream/40"
        />
        <button
          id="library-search-clear"
          class="absolute right-2 top-1/2 -translate-y-1/2 w-6 h-6 hidden items-center justify-center rounded hover:bg-ink/10 dark:hover:bg-cream/10"
          aria-label="Clear search"
        ><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 6l12 12M6 18L18 6"/></svg></button>
      </div>
      <div id="library-search-status" class="mt-2 text-xs text-ink/50 dark:text-cream/50 hidden"></div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 grid md:grid-cols-[220px_minmax(0,1fr)] gap-10">
    <aside class="md:sticky md:top-24 md:self-start">
      <div class="text-xs font-bold uppercase tracking-wider text-ink/50 dark:text-cream/50 mb-3">Contents</div>
      <ul class="space-y-1 text-sm" id="library-toc">
        {library.map(it => (
          <li data-toc-slug={it.slug}>
            <a href={`#${it.slug}`} class="block px-3 py-1.5 rounded-md hover:bg-brand-yellow/40">{it.title}</a>
          </li>
        ))}
        <li>
          <a href="#data" class="block px-3 py-1.5 rounded-md hover:bg-brand-yellow/40 font-semibold">Data — public goods</a>
        </li>
      </ul>
    </aside>

    <div class="space-y-10">
      {library.map(it => (
        <article
          id={it.slug}
          data-library-item
          data-search={`${it.title} ${it.tag} ${it.blurb.join(' ')}`.toLowerCase()}
          class="card"
        >
          <div class="flex items-center gap-2 flex-wrap">
            <span class="badge badge-cream">{it.tag}</span>
          </div>
          <h2 class="font-display text-2xl md:text-3xl font-bold mt-3">{it.title}</h2>
          <div class="mt-3 space-y-3 text-ink/85 dark:text-cream/85 leading-relaxed">
            {it.slug === 'dylan'
              ? it.blurb.map((p, i) => (
                  <>
                    <p>{p}</p>
                    {dylanFigures[i] && (
                      <figure class="my-4">
                        <img src={dylanFigures[i].src} alt={dylanFigures[i].caption} loading="lazy" class="w-full h-auto bg-white border border-ink/15 dark:border-cream/15 rounded-sm" />
                      </figure>
                    )}
                  </>
                ))
              : it.blurb.map(p => <p>{p}</p>)}
          </div>
          <div class="mt-5 flex flex-wrap gap-2">
            {it.links.map(l => (
              <a href={l.url} target="_blank" rel="noopener"
                 class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-md border-2 border-ink dark:border-cream bg-white dark:bg-ink-3 hover:bg-brand-yellow dark:hover:bg-brand-yellow dark:hover:text-ink transition-colors">
                {l.label}
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
              </a>
            ))}
          </div>
        </article>
      ))}

      <!-- DATA / PUBLIC GOODS — mirrors the old site's Public Goods → Data -->
      <article id="data" data-library-item data-search={`data public goods ${datasets.map(d => d.name + ' ' + d.blurb).join(' ').toLowerCase()}`} class="card">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="badge badge-teal">Open data</span>
        </div>
        <h2 class="font-display text-2xl md:text-3xl font-bold mt-3">Data — public goods</h2>
        <p class="mt-3 text-ink/85 dark:text-cream/85 leading-relaxed">
          Datasets released alongside the papers, free to use with attribution.
        </p>
        <div class="mt-5 space-y-6">
          {datasets.map(d => (
            <div class="border-t border-ink/15 dark:border-cream/15 pt-4">
              <h3 class="font-display font-bold text-lg">{d.name}</h3>
              <div class="text-sm text-ink/60 dark:text-cream/60 mt-0.5">with {d.with.join(', ')}</div>
              <p class="mt-2 text-sm text-ink/80 dark:text-cream/80 leading-relaxed">{d.blurb}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {d.links.map(l => (
                  <a href={l.url} target="_blank" rel="noopener"
                     class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-md border-2 border-ink dark:border-cream bg-white dark:bg-ink-3 hover:bg-brand-yellow dark:hover:bg-brand-yellow dark:hover:text-ink transition-colors">
                    {l.label}
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
                  </a>
                ))}
                {d.paperSlug && (
                  <a href={`/research/${d.paperSlug}`}
                     class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-md border-2 border-ink/40 dark:border-cream/40 hover:bg-brand-yellow/40 transition-colors">
                    Paper page →
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  <script is:inline>
    (function () {
      const input  = document.getElementById('library-search');
      const clear  = document.getElementById('library-search-clear');
      const status = document.getElementById('library-search-status');
      const items  = document.querySelectorAll('[data-library-item]');
      const tocItems = document.querySelectorAll('[data-toc-slug]');
      function apply(q) {
        let shown = 0;
        items.forEach(it => {
          const hay = it.getAttribute('data-search') || '';
          const ok = q === '' || hay.indexOf(q) !== -1;
          it.style.display = ok ? '' : 'none';
          if (ok) shown++;
          // also hide the matching TOC entry
          const slug = it.id;
          const tocLi = document.querySelector('[data-toc-slug="' + slug + '"]');
          if (tocLi) tocLi.style.display = ok ? '' : 'none';
        });
        if (q !== '') {
          status.textContent = shown + ' item' + (shown === 1 ? '' : 's') + ' matching "' + q + '"';
          status.classList.remove('hidden');
        } else {
          status.classList.add('hidden');
        }
      }
      input.addEventListener('input', e => {
        const q = e.target.value.trim().toLowerCase();
        clear.style.display = q ? 'flex' : 'none';
        apply(q);
      });
      clear.addEventListener('click', () => {
        input.value = '';
        clear.style.display = 'none';
        apply('');
        input.focus();
      });
    })();
  </script>
</Layout>
