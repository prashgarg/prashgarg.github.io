---
import Layout from '../layouts/Layout.astro';
import { library } from '../data/site';
---
<Layout title="Library — Prashant Garg" current="library">
  <section class="border-b-2 border-ink dark:border-cream">
    <div class="max-w-6xl mx-auto px-4 pt-14 pb-10">
      <div class="text-xs font-bold uppercase tracking-wider text-brand-red">Library</div>
      <h1 class="font-display text-4xl md:text-5xl font-bold mt-2">Code, notes, and the occasional essay.</h1>
      <p class="mt-4 text-ink/70 dark:text-cream/70 max-w-2xl">
        Public goods: open-source code, methods notes, and writing that doesn't fit a paper.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 grid md:grid-cols-[220px_minmax(0,1fr)] gap-10">
    <aside class="md:sticky md:top-24 md:self-start">
      <div class="text-xs font-bold uppercase tracking-wider text-ink/50 dark:text-cream/50 mb-3">Contents</div>
      <ul class="space-y-1 text-sm">
        {library.map(it => (
          <li>
            <a href={`#${it.slug}`} class="block px-3 py-1.5 rounded-md hover:bg-brand-yellow/40">{it.title}</a>
          </li>
        ))}
      </ul>
    </aside>

    <div class="space-y-10">
      {library.map(it => (
        <article id={it.slug} class="card">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="badge badge-cream">{it.tag}</span>
          </div>
          <h2 class="font-display text-2xl md:text-3xl font-bold mt-3">{it.title}</h2>
          <p class="mt-3 text-ink/85 dark:text-cream/85 leading-relaxed">{it.blurb}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {it.links.map(l => (
              <a href={l.url} target="_blank" rel="noopener"
                 class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-md border-2 border-ink dark:border-cream bg-white dark:bg-ink-3 hover:bg-brand-yellow dark:hover:bg-brand-yellow dark:hover:text-ink transition-colors">
                {l.label}
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
              </a>
            ))}
          </div>
        </article>
      ))}

      <article class="card bg-brand-yellow !border-ink">
        <h2 class="font-display text-xl font-bold">More coming.</h2>
        <p class="mt-2 text-sm text-ink/80">This is where future essays, teaching notes, and reading lists will land.</p>
      </article>
    </div>
  </section>
</Layout>
