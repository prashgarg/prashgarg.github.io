---
import Layout from '../layouts/Win95Layout.astro';
import { library, datasets, papers } from '../data/site';

// Dylan essay figures live on the paper entry — interleave them with
// the matching blurb paragraphs (they were written as captions).
const dylanFigures = papers.find(p => p.slug === 'mapping-dylans-mind')?.figures || [];
---
<Layout title="Library — Prashant Garg" current="library">
  <article class="max-w-3xl mx-auto px-4 pt-14 pb-20">
    <h1 class="font-display text-3xl md:text-4xl font-bold mb-2">Library</h1>
    <p class="text-sm text-ink/60 dark:text-cream/60 mb-8">Code, open data, and the occasional essay.</p>

    {library.map(it => (
      <section id={it.slug} class="mb-12">
        <h2 class="font-display text-2xl font-bold">{it.title}</h2>
        <div class="mt-3 space-y-3 text-ink/85 dark:text-cream/85 leading-relaxed">
          {it.slug === 'dylan'
            ? it.blurb.map((p, i) => (
                <>
                  <p>{p}</p>
                  {dylanFigures[i] && (
                    <figure class="my-4">
                      <img src={dylanFigures[i].src} alt={dylanFigures[i].caption} loading="lazy" class="w-full h-auto bg-white border border-ink/15 dark:border-cream/15" />
                    </figure>
                  )}
                </>
              ))
            : it.blurb.map(p => <p>{p}</p>)}
        </div>
        <div class="mt-4 text-sm">
          {it.links.map((l, i) => (
            <>{i > 0 && <span class="text-ink/40 dark:text-cream/40"> · </span>}<a href={l.url} target="_blank" rel="noopener" class="text-brand-red hover:underline">{l.label}</a></>
          ))}
        </div>
      </section>
    ))}

    <!-- DATA / PUBLIC GOODS — mirrors the old site's Public Goods → Data -->
    <section id="data" class="mb-8">
      <h2 class="font-display text-2xl font-bold">Data — public goods</h2>
      <p class="mt-2 text-ink/80 dark:text-cream/80">Datasets released alongside the papers, free to use with attribution.</p>
      <div class="mt-4 space-y-5">
        {datasets.map(d => (
          <div>
            <h3 class="font-display font-semibold text-lg">{d.name}</h3>
            <div class="text-sm text-ink/60 dark:text-cream/60">with {d.with.join(', ')}</div>
            <p class="mt-1 text-sm text-ink/80 dark:text-cream/80 leading-relaxed">{d.blurb}</p>
            <div class="mt-1.5 text-sm">
              {d.links.map((l, i) => (
                <>{i > 0 && <span class="text-ink/40 dark:text-cream/40"> · </span>}<a href={l.url} target="_blank" rel="noopener" class="text-brand-red hover:underline">{l.label}</a></>
              ))}
              {d.paperSlug && <><span class="text-ink/40 dark:text-cream/40"> · </span><a href={`/research/${d.paperSlug}`} class="text-brand-red hover:underline">Paper</a></>}
            </div>
          </div>
        ))}
      </div>
    </section>
  </article>
</Layout>
