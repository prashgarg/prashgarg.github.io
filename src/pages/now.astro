---
import Layout from '../layouts/Win95Layout.astro';
import { papers, talks } from '../data/site';

// Build a combined recent-activity timeline from papers + talks.
// Each item gets a (year, month) tuple for sorting; talks have explicit
// month dates, papers default to mid-year (June).
const MONTHS = ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'];
function monthIdx(d: string) {
  const m = d.toLowerCase().match(/\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\b/);
  return m ? MONTHS.indexOf(m[1]) : 6;
}

type FeedItem = {
  year: number;
  month: number;
  date: string;
  type: 'paper' | 'talk';
  title: string;
  meta: string;
  url?: string;
};

const feed: FeedItem[] = [
  ...papers
    .filter(p => p.year)
    .map<FeedItem>(p => ({
      year: p.year!, month: 5,
      date: String(p.year),
      type: 'paper',
      title: p.title,
      meta: `${p.venue || 'Working paper'}${p.coauthors.length ? ' · with ' + p.coauthors.join(', ') : ''}`,
      url: `/research/${p.slug}`,
    })),
  ...talks.map<FeedItem>(t => ({
    year: t.year, month: monthIdx(t.date),
    date: t.date,
    type: 'talk',
    title: t.venue,
    meta: t.location,
    url: t.url,
  })),
].sort((a, b) => (b.year - a.year) || (b.month - a.month)).slice(0, 24);
---
<Layout title="Now — Prashant Garg" current="now">
  <section>
    <div class="max-w-3xl mx-auto px-4 pt-14 pb-6">
      <h1 class="font-display text-3xl md:text-4xl font-bold">Now</h1>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 pb-12 space-y-5 text-base leading-relaxed">
    <p>
      Cambridge, May 2026. Postdoc.
    </p>
    <p>
      Working on the <span class="font-semibold">Global Automation Atlas</span> —
      mapping where automation is arriving across global production networks
      and what it displaces when it does.
    </p>
    <p>
      Writing poetry on the backs of postcards.
    </p>
    <p class="text-sm text-ink/50 italic">Updated May 2026.</p>
  </section>

  <!-- RECENT ACTIVITY TIMELINE -->
  <section class="max-w-3xl mx-auto px-4 pb-20">
    <div class="flex items-end justify-between border-b border-ink/15 dark:border-cream/15 pb-2 mb-5">
      <h2 class="font-display text-xl font-bold">Recent activity</h2>
      <a href="/papers.xml" class="text-xs text-ink/55 dark:text-cream/55 hover:underline" title="Atom feed">
        Atom / RSS ↗
      </a>
    </div>

    <ol class="relative border-l border-ink/20 dark:border-cream/20 ml-2 pl-6 space-y-5">
      {feed.map(item => (
        <li class="relative">
          <span
            class={`absolute -left-[31px] top-1.5 w-3 h-3 rounded-full ring-2 ring-cream dark:ring-ink ${
              item.type === 'paper' ? 'bg-brand-red' : 'bg-brand-yellow'
            }`}
            aria-hidden="true"
          ></span>
          <div class="flex items-baseline gap-2 flex-wrap">
            <span class="text-xs font-mono uppercase tracking-wider text-ink/50 dark:text-cream/50">
              {item.type === 'paper' ? 'Paper' : 'Talk'}
            </span>
            <span class="text-xs text-ink/45 dark:text-cream/45">{item.date}</span>
          </div>
          <div class="mt-0.5">
            {item.url
              ? <a href={item.url} class="font-display font-semibold hover:underline">{item.title}</a>
              : <span class="font-display font-semibold">{item.title}</span>}
          </div>
          <div class="text-sm text-ink/60 dark:text-cream/60">{item.meta}</div>
        </li>
      ))}
    </ol>
  </section>
</Layout>
