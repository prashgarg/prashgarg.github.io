---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Not found — Prashant Garg">
  <section class="max-w-3xl mx-auto px-4 py-32 text-center">
    <div class="inline-block bg-brand-yellow px-3 py-1 border-2 border-ink shadow-[3px_3px_0_0_var(--color-ink)] dark:shadow-[3px_3px_0_0_var(--color-cream)] rotate-[-1deg] font-display font-bold mb-6">
      404
    </div>
    <h1 class="font-display text-4xl md:text-5xl font-bold tracking-tight">This page wandered off.</h1>
    <p class="mt-4 text-ink/70 dark:text-cream/70">It might have been renamed, moved, or it never existed.</p>
    <div class="mt-8 flex flex-wrap gap-3 justify-center">
      <a href="/" class="btn btn-primary">Go home</a>
      <a href="/research" class="btn">Research</a>
      <a href="/talks" class="btn">Talks</a>
    </div>
  </section>
</Layout>
