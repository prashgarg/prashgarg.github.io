---
import Layout from '../../layouts/Win95Layout.astro';
import { site, papers, tools, talks, topicForTalk, type Paper, type Talk } from '../../data/site';

export async function getStaticPaths() {
  return papers.map(p => ({ params: { slug: p.slug }, props: { paper: p } }));
}

interface Props { paper: Paper }
const { paper } = Astro.props;
const tool = paper.tools?.length ? tools.find(t => t.slug === paper.tools![0]) : undefined;

// Talks for this paper
const MONTHS = ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'];
function monthIndex(date: string): number {
  const m = date.toLowerCase().match(/\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\b/);
  return m ? MONTHS.indexOf(m[1]) : 6;
}
function sortValue(t: Talk): number { return t.year * 12 + monthIndex(t.date); }

const myTalks: Talk[] = talks
  .filter(t => topicForTalk(t.title).paperSlug === paper.slug)
  .sort((a, b) => sortValue(b) - sortValue(a));

// Absolute URLs use site.origin — prashantgarg.org still serves the
// old Google Site until the DNS cutover (see site.ts).
const pageUrl = `${site.origin}/research/${paper.slug}`;

// JSON-LD ScholarlyArticle for academic indexing (Google Scholar, etc.)
const scholarlyJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: paper.title,
  abstract: paper.blurb.slice(0, 600),
  author: [
    { '@type': 'Person', name: 'Prashant Garg', url: site.origin },
    ...paper.coauthors.map(c => ({ '@type': 'Person', name: c })),
  ],
  ...(paper.year ? { datePublished: String(paper.year) } : {}),
  ...(paper.venue ? { publisher: { '@type': 'Organization', name: paper.venue } } : {}),
  url: pageUrl,
};

// BibTeX entry (server-rendered into a data attribute for the copy
// button). Authors in consistent "Lastname, Firstname" form; DOI when
// derivable (Nature article ids map 1:1 to 10.1038/<id>); url prefers
// the canonical publisher/preprint link over this site.
function bibName(full: string): string {
  const parts = full.trim().split(/\s+/);
  return parts.length < 2 ? full : `${parts[parts.length - 1]}, ${parts.slice(0, -1).join(' ')}`;
}
const bibKey = `garg${paper.year || ''}${paper.slug.split('-')[0]}`;
const bibEntryType = paper.venue && /journal|review|economics|nature|science|letters/i.test(paper.venue) ? 'article' : 'misc';
const bibAuthor = ['Prashant Garg', ...paper.coauthors].map(bibName).join(' and ');
const natureId = paper.links.map(l => l.url.match(/nature\.com\/articles\/([a-z0-9.-]+)/i)?.[1]).find(Boolean);
const doi = natureId ? `10.1038/${natureId}` : undefined;
const bibUrl = paper.links[0]?.url || pageUrl;
const bibTeX = [
  `@${bibEntryType}{${bibKey},`,
  `  author = {${bibAuthor}},`,
  `  title  = {${paper.title}},`,
  ...(paper.venue ? [`  journal = {${paper.venue.replace(/\s*\((Forthcoming|R&R)\)\s*$/i, '')}},`] : []),
  ...(paper.year ? [`  year   = {${paper.year}},`] : []),
  ...(doi ? [`  doi    = {${doi}},`] : []),
  `  url    = {${bibUrl}}`,
  '}',
].join('\n');
---
<Layout title={`${paper.title} — Prashant Garg`} description={paper.blurb} current="research">
  <!-- JSON-LD structured data for academic indexing -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(scholarlyJsonLd)} />

  <article class="max-w-3xl mx-auto px-4 pt-10 pb-20">
    <a href="/research" class="text-sm text-ink/55 dark:text-cream/55 hover:underline">← All research</a>

    <h1 class="font-display text-2xl md:text-4xl font-bold leading-tight tracking-tight mt-4">{paper.title}</h1>

    <div class="mt-2 text-base text-ink/70 dark:text-cream/70">
      {paper.coauthors.length > 0 && <span>with {paper.coauthors.join(', ')}</span>}
      {paper.coauthors.length > 0 && (paper.venue || paper.year) && <span> · </span>}
      {paper.venue && <span>{paper.venue}</span>}
      {paper.venue && paper.year && <span>, {paper.year}</span>}
      {!paper.venue && paper.year && <span>{paper.year}</span>}
      {paper.award && <span> · {paper.award.url ? <a href={paper.award.url} target="_blank" rel="noopener" class="hover:underline">{paper.award.label}</a> : paper.award.label}</span>}
    </div>

    <p class="mt-6 text-base leading-relaxed text-ink/90 dark:text-cream/90">{paper.blurb}</p>

    <div class="mt-5 text-sm">
      {paper.links.map((l, i) => (
        <>{i > 0 && <span class="text-ink/40 dark:text-cream/40"> · </span>}<a href={l.url} target="_blank" rel="noopener" class="text-brand-red hover:underline">{l.label}</a></>
      ))}
      {tool && <><span class="text-ink/40 dark:text-cream/40"> · </span><a href={tool.url} target="_blank" rel="noopener" class="text-brand-red hover:underline">{tool.name}</a></>}
      <span class="text-ink/40 dark:text-cream/40"> · </span>
      <button type="button" id="cite-btn" data-bibtex={bibTeX} class="text-brand-red hover:underline">BibTeX</button>
    </div>

    {paper.coverage && paper.coverage.length > 0 && (
      <div class="mt-2 text-sm text-ink/70 dark:text-cream/70">
        Coverage: {paper.coverage.map((c, i) => (
          <>{i > 0 && <span>, </span>}<a href={c.url} target="_blank" rel="noopener" class="hover:underline">{c.outlet}</a></>
        ))}
      </div>
    )}

    {paper.figures && paper.figures.length > 0 && (
      <div class="mt-8 space-y-6">
        {paper.figures.map(f => (
          <figure>
            <img src={f.src} alt={f.caption} loading="lazy" class="w-full h-auto bg-white border border-ink/15 dark:border-cream/15" />
            <figcaption class="mt-2 text-sm leading-relaxed text-ink/65 dark:text-cream/65">{f.caption}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {myTalks.length > 0 && (
      <section class="mt-10 pt-6 border-t border-ink/15 dark:border-cream/15">
        <h2 class="font-display text-lg font-bold mb-2">Presented at</h2>
        <ul class="space-y-1 text-sm text-ink/80 dark:text-cream/80">
          {myTalks.map(t => (
            <li>
              <span class="text-ink/55 dark:text-cream/55">{t.date}</span> —
              {t.url
                ? <a href={t.url} target="_blank" rel="noopener" class="hover:underline">{t.venue}</a>
                : <span>{t.venue}</span>}, {t.location}
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  <script is:inline>
    (function () {
      const citeBtn = document.getElementById('cite-btn');
      if (citeBtn) {
        citeBtn.addEventListener('click', async () => {
          const bib = citeBtn.getAttribute('data-bibtex') || '';
          const orig = citeBtn.textContent;
          try { await navigator.clipboard.writeText(bib); citeBtn.textContent = 'BibTeX copied'; setTimeout(() => { citeBtn.textContent = orig; }, 1600); }
          catch { window.prompt('Copy BibTeX:', bib); }
        });
      }
    })();
  </script>
</Layout>
