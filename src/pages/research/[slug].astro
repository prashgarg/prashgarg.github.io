---
import Layout from '../../layouts/Win95Layout.astro';
import { papers, statusMeta, tools, talks, topicForTalk, type Paper, type Talk } from '../../data/site';

export async function getStaticPaths() {
  return papers.map(p => ({ params: { slug: p.slug }, props: { paper: p } }));
}

interface Props { paper: Paper }
const { paper } = Astro.props;
const tool = paper.tools?.length ? tools.find(t => t.slug === paper.tools![0]) : undefined;

// Sibling navigation
const idx = papers.findIndex(p => p.slug === paper.slug);
const prev = idx > 0 ? papers[idx - 1] : null;
const next = idx < papers.length - 1 ? papers[idx + 1] : null;

// Talks for this paper
const MONTHS = ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'];
function monthIndex(date: string): number {
  const m = date.toLowerCase().match(/\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\b/);
  return m ? MONTHS.indexOf(m[1]) : 6;
}
function sortValue(t: Talk): number { return t.year * 12 + monthIndex(t.date); }

const myTalks: Talk[] = talks
  .filter(t => topicForTalk(t.title).paperSlug === paper.slug)
  .sort((a, b) => sortValue(b) - sortValue(a));

// JSON-LD ScholarlyArticle for academic indexing (Google Scholar, etc.)
const scholarlyJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: paper.title,
  abstract: paper.blurb.slice(0, 600),
  author: [
    { '@type': 'Person', name: 'Prashant Garg', url: 'https://prashantgarg.org' },
    ...paper.coauthors.map(c => ({ '@type': 'Person', name: c })),
  ],
  ...(paper.year ? { datePublished: String(paper.year) } : {}),
  ...(paper.venue ? { publisher: { '@type': 'Organization', name: paper.venue } } : {}),
  url: `https://prashantgarg.org/research/${paper.slug}`,
};

// BibTeX entry (server-rendered into a data attribute for the copy button)
const bibKey = `garg${paper.year || ''}${paper.slug.split('-')[0]}`;
const bibEntryType = paper.venue && /journal|review|economics|nature|science|letters/i.test(paper.venue) ? 'article' : 'misc';
const bibAuthor = paper.coauthors.length ? `Garg, Prashant and ${paper.coauthors.join(' and ')}` : 'Garg, Prashant';
const bibTeX = [
  `@${bibEntryType}{${bibKey},`,
  `  author = {${bibAuthor}},`,
  `  title  = {${paper.title}},`,
  ...(paper.venue ? [`  journal = {${paper.venue}},`] : []),
  ...(paper.year ? [`  year   = {${paper.year}},`] : []),
  `  url    = {https://prashantgarg.org/research/${paper.slug}}`,
  '}',
].join('\n');
---
<Layout title={`${paper.title} — Prashant Garg`} description={paper.blurb} current="research">
  <!-- JSON-LD structured data for academic indexing -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(scholarlyJsonLd)} />

  <article class="max-w-4xl mx-auto px-4 pt-10 pb-20">
    <div class="flex items-center justify-between gap-4 mb-6 flex-wrap">
      <a href="/research" class="inline-flex items-center gap-1.5 text-sm font-semibold hover:bg-brand-yellow/40 px-1">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M11 5l-7 7 7 7"/></svg>
        All research
      </a>
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="cite-btn"
          data-bibtex={bibTeX}
          class="inline-flex items-center gap-2 text-sm font-semibold px-3 py-1.5 border-2 border-ink dark:border-cream rounded-md bg-white dark:bg-ink-2 hover:bg-brand-yellow"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Cite (BibTeX)
        </button>
        <button
          type="button"
          id="copy-link-btn"
          class="inline-flex items-center gap-2 text-sm font-semibold px-3 py-1.5 border-2 border-ink dark:border-cream rounded-md bg-white dark:bg-ink-2 hover:bg-brand-yellow"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
          Copy link
        </button>
      </div>
    </div>

    <div class="flex items-center gap-2 flex-wrap mb-3">
      <span class={`badge ${statusMeta[paper.status].badge}`}>{statusMeta[paper.status].label}</span>
      {paper.venue && <span class="text-sm font-medium text-ink/60 dark:text-cream/60">{paper.venue}{paper.year ? ` · ${paper.year}` : ''}</span>}
    </div>

    <h1 class="font-display text-3xl md:text-5xl font-bold leading-tight tracking-tight">{paper.title}</h1>

    {paper.coauthors.length > 0 && (
      <div class="mt-3 text-base text-ink/70 dark:text-cream/70">
        with {paper.coauthors.map((c, i) => (
          <span><span class="font-semibold">{c}</span>{i < paper.coauthors.length - 1 ? ', ' : ''}</span>
        ))}
      </div>
    )}

    <details class="mt-8 group">
      <summary class="list-none cursor-pointer inline-flex items-center gap-2 text-sm font-semibold hover:bg-brand-yellow/40 px-2 py-1 -mx-2 rounded">
        <span class="inline-flex items-center justify-center w-5 h-5 transition-transform group-open:rotate-45">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
        </span>
        Abstract
      </summary>
      <p class="mt-4 text-base leading-relaxed text-ink/90 dark:text-cream/90">{paper.blurb}</p>
    </details>

    <!-- LINKS -->
    <section class="mt-10">
      <div class="text-xs font-bold uppercase tracking-wider text-ink/50 dark:text-cream/50 mb-3">Links</div>
      <div class="flex flex-wrap gap-2">
        {paper.links.map(l => (
          <a href={l.url} target="_blank" rel="noopener"
             class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-md border-2 border-ink dark:border-cream bg-white dark:bg-ink-3 hover:bg-brand-yellow dark:hover:bg-brand-yellow dark:hover:text-ink transition-colors">
            {l.label}
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
          </a>
        ))}
      </div>
    </section>

    {tool && (
      <section class="mt-8">
        <a href={tool.url} target="_blank" rel="noopener" class="card flex items-center justify-between gap-4 hover:bg-brand-yellow/20 transition-colors">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-brand-red">Companion site</div>
            <div class="font-display font-bold text-xl mt-1">{tool.name}</div>
            <div class="text-sm text-ink/70 dark:text-cream/70 mt-1">{tool.blurb}</div>
            <div class="text-xs font-mono text-ink/50 dark:text-cream/50 mt-2">{tool.url.replace(/^https?:\/\//, '')}</div>
          </div>
          <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
        </a>
      </section>
    )}

    {paper.coverage && paper.coverage.length > 0 && (
      <section class="mt-10">
        <div class="text-xs font-bold uppercase tracking-wider text-ink/50 dark:text-cream/50 mb-3">As seen in</div>
        <div class="flex flex-wrap gap-2">
          {paper.coverage.map(c => (
            <a href={c.url} target="_blank" rel="noopener" class="chip hover:bg-brand-yellow/60">{c.outlet}</a>
          ))}
        </div>
      </section>
    )}

    {myTalks.length > 0 && (
      <section class="mt-10 pt-8 border-t border-ink/15 dark:border-cream/15">
        <div class="text-xs font-bold uppercase tracking-wider text-ink/50 dark:text-cream/50 mb-3">Presented at</div>
        <ul class="space-y-1 text-sm text-ink/80 dark:text-cream/80">
          {myTalks.map(t => (
            <li class="flex gap-3">
              <span class="shrink-0 w-24 text-xs font-mono text-ink/55 dark:text-cream/55">{t.date}</span>
              <span class="min-w-0">
                {t.url
                  ? <a href={t.url} target="_blank" rel="noopener" class="hover:underline">{t.venue}</a>
                  : <span>{t.venue}</span>}
                <span class="text-ink/45 dark:text-cream/45"> · {t.location}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Sibling nav -->
    <nav class="mt-16 pt-8 border-t border-ink/15 dark:border-cream/15 grid sm:grid-cols-2 gap-3">
      {prev ? (
        <a href={`/research/${prev.slug}`} class="card hover:bg-brand-yellow/20 transition-colors block">
          <div class="text-xs font-bold uppercase tracking-wider text-ink/50 dark:text-cream/50">Previous</div>
          <div class="font-display font-semibold mt-1">{prev.title}</div>
        </a>
      ) : <span></span>}
      {next ? (
        <a href={`/research/${next.slug}`} class="card hover:bg-brand-yellow/20 transition-colors block sm:text-right">
          <div class="text-xs font-bold uppercase tracking-wider text-ink/50 dark:text-cream/50">Next</div>
          <div class="font-display font-semibold mt-1">{next.title}</div>
        </a>
      ) : <span></span>}
    </nav>
  </article>

  <script is:inline>
    (function () {
      const citeBtn = document.getElementById('cite-btn');
      const linkBtn = document.getElementById('copy-link-btn');
      function flash(btn, label) {
        const orig = btn.innerHTML;
        btn.innerHTML = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg> ' + label;
        setTimeout(() => { btn.innerHTML = orig; }, 1800);
      }
      if (citeBtn) {
        citeBtn.addEventListener('click', async () => {
          const bib = citeBtn.getAttribute('data-bibtex') || '';
          try { await navigator.clipboard.writeText(bib); flash(citeBtn, 'Copied!'); }
          catch { window.prompt('Copy BibTeX:', bib); }
        });
      }
      if (linkBtn) {
        linkBtn.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(window.location.href); flash(linkBtn, 'Copied!'); }
          catch { window.prompt('Copy link:', window.location.href); }
        });
      }
    })();
  </script>
</Layout>
