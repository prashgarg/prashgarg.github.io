---
import Layout from '../../layouts/Win95Layout.astro';
import PaperLinks from '../../components/PaperLinks.astro';
import PaperFigures from '../../components/PaperFigures.astro';
import { paperFigures } from '../../data/paperFigures';
import { site, papers, tools, talks, topicForTalk, topicsForPaper, TOPIC_TAGS, type Paper, type Talk } from '../../data/site';
import { bibtexForPaper, scholarlyArticleForPaper } from '../../lib/citations';

export async function getStaticPaths() {
  return papers.map(p => ({ params: { slug: p.slug }, props: { paper: p } }));
}

interface Props { paper: Paper }
const { paper } = Astro.props;
const tool = paper.tools?.length ? tools.find(t => t.slug === paper.tools![0]) : undefined;
// Topic tags for a cross-field reader (uses the same helper as the research filter)
const tagLabels = topicsForPaper(paper)
  .map(s => TOPIC_TAGS.find(t => t.slug === s)?.label)
  .filter((l): l is string => Boolean(l));

// Talks for this paper
const MONTHS = ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'];
function monthIndex(date: string): number {
  const m = date.toLowerCase().match(/\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\b/);
  return m ? MONTHS.indexOf(m[1]) : 6;
}
function sortValue(t: Talk): number { return t.year * 12 + monthIndex(t.date); }

const myTalks: Talk[] = talks
  .filter(t => topicForTalk(t.title).paperSlug === paper.slug)
  .sort((a, b) => sortValue(b) - sortValue(a));

// Absolute URLs use the canonical production origin.
const pageUrl = `${site.origin}/research/${paper.slug}`;

// Citation metadata is explicit for published records and conservative for
// work still under review, so structured data and BibTeX stay truthful.
const scholarlyJsonLd = scholarlyArticleForPaper(paper, pageUrl);
const bibTeX = bibtexForPaper(paper, pageUrl);
---
<Layout title={`${paper.title} — Prashant Garg`} description={paper.blurb} current="research">
  <!-- JSON-LD structured data for academic indexing -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(scholarlyJsonLd)} />

  <article class="max-w-3xl mx-auto px-4 pt-10 pb-20">
    <a href="/research" class="text-sm text-ink/70 dark:text-cream/65 hover:underline">← All research</a>

    <h1 class="font-display text-2xl md:text-4xl font-bold leading-tight tracking-tight mt-4">{paper.title}</h1>

    <div class="mt-2 text-base text-ink/70 dark:text-cream/70">
      {paper.coauthors.length > 0 && <span>with {paper.coauthors.join(', ')}</span>}
      {paper.coauthors.length > 0 && (paper.venue || paper.year) && <span> · </span>}
      {paper.venue && <span>{paper.venue}</span>}
      {paper.status === 'rr' && <span> (R&amp;R)</span>}
      {paper.status === 'accepted' && <span> (forthcoming)</span>}
      {paper.venue && paper.year && <span>, {paper.year}</span>}
      {!paper.venue && paper.year && <span>{paper.year}</span>}
      {paper.award && <span> · {paper.award.url ? <a href={paper.award.url} target="_blank" rel="noopener" class="hover:underline">{paper.award.label}</a> : paper.award.label}</span>}
    </div>

    <PaperLinks links={paper.links} tool={tool} bibtex={bibTeX} />

    {tagLabels.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tagLabels.map(l => (
          <span class="text-xs px-2 py-0.5 rounded-full border border-ink/20 dark:border-cream/20 text-ink/70 dark:text-cream/65">{l}</span>
        ))}
      </div>
    )}

    {paper.tldr ? (
      <>
        {/* Plain-English summary up top; dense abstract behind a native toggle */}
        <p class="mt-6 text-lg leading-relaxed text-ink/90 dark:text-cream/90">{paper.tldr}</p>
        <details class="mt-4">
          <summary class="cursor-pointer text-sm text-brand-red hover:underline">Read the full abstract</summary>
          <p class="mt-3 text-base leading-relaxed text-ink/75 dark:text-cream/75">{paper.blurb}</p>
        </details>
      </>
    ) : (
      <p class="mt-6 text-base leading-relaxed text-ink/90 dark:text-cream/90">{paper.blurb}</p>
    )}

    {paper.coverage && paper.coverage.length > 0 && (
      <div class="mt-2 text-sm text-ink/70 dark:text-cream/70">
        Coverage: {paper.coverage.map((c, i) => (
          <>{i > 0 && <span>, </span>}<a href={c.url} target="_blank" rel="noopener" class="hover:underline">{c.outlet}</a></>
        ))}
      </div>
    )}

    <PaperFigures figures={paperFigures[paper.slug] ?? paper.figures} />

    {myTalks.length > 0 && (
      <section class="mt-10 pt-6 border-t border-ink/15 dark:border-cream/15">
        <h2 class="font-display text-lg font-bold mb-2">Presented at</h2>
        <ul class="space-y-1 text-sm text-ink/80 dark:text-cream/80">
          {myTalks.map(t => (
            <li>
              <span class="text-ink/70 dark:text-cream/65">{t.date}</span> —
              {t.url
                ? <a href={t.url} target="_blank" rel="noopener" class="hover:underline">{t.venue}</a>
                : <span>{t.venue}</span>}, {t.location}
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  <script is:inline>
    (function () {
      const citeBtn = document.getElementById('cite-btn');
      if (citeBtn) {
        citeBtn.addEventListener('click', async () => {
          const bib = citeBtn.getAttribute('data-bibtex') || '';
          const orig = citeBtn.textContent;
          try { await navigator.clipboard.writeText(bib); citeBtn.textContent = 'BibTeX copied'; setTimeout(() => { citeBtn.textContent = orig; }, 1600); }
          catch { window.prompt('Copy BibTeX:', bib); }
        });
      }
    })();
  </script>
</Layout>
