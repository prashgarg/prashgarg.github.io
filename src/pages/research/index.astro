---
import Layout from '../../layouts/Win95Layout.astro';
import { papers, tools, type PaperStatus } from '../../data/site';

const order: PaperStatus[] = ['published', 'accepted', 'rr', 'working', 'other'];
const sectionTitles: Record<PaperStatus, string> = {
  published: 'Publications',
  accepted:  'Forthcoming',
  rr:        'Revise & Resubmit',
  working:   'Working papers',
  other:     'Essays & other writing',
};
const grouped = order.map(s => ({ status: s, items: papers.filter(p => p.status === s) }))
                     .filter(g => g.items.length > 0);
const toolFor = (slug?: string) => slug ? tools.find(t => t.slug === slug) : undefined;
---
<Layout title="Research — Prashant Garg" current="research">
  <article class="max-w-3xl mx-auto px-4 pt-14 pb-20">
    <h1 class="font-display text-3xl md:text-4xl font-bold mb-8">Research</h1>

    {grouped.map(group => (
      <section class="mb-10">
        <h2 class="font-display text-xl md:text-2xl font-bold mb-4 pb-1 border-b border-ink/20 dark:border-cream/20">{sectionTitles[group.status]}</h2>
        <ul class="space-y-6">
          {group.items.map(p => {
            const tool = toolFor(p.tools?.[0]);
            return (
              <li id={p.slug}>
                <h3 class="font-display font-semibold text-lg leading-snug">
                  <a href={`/research/${p.slug}`} class="hover:underline">{p.title}</a>
                </h3>
                <div class="mt-1 text-sm text-ink/70 dark:text-cream/70">
                  {p.coauthors.length > 0 && <span>with {p.coauthors.join(', ')}</span>}
                  {p.coauthors.length > 0 && (p.venue || p.year) && <span> · </span>}
                  {p.venue && <span>{p.venue}</span>}
                  {p.venue && p.year && <span>, {p.year}</span>}
                  {!p.venue && p.year && <span>{p.year}</span>}
                  {p.award && <span> · {p.award.url ? <a href={p.award.url} target="_blank" rel="noopener" class="hover:underline">{p.award.label}</a> : p.award.label}</span>}
                </div>
                <div class="mt-1.5 text-sm">
                  {p.links.map((l, i) => (
                    <>{i > 0 && <span class="text-ink/40 dark:text-cream/40"> · </span>}<a href={l.url} target="_blank" rel="noopener" class="text-brand-red hover:underline">{l.label}</a></>
                  ))}
                  {tool && <><span class="text-ink/40 dark:text-cream/40"> · </span><a href={tool.url} target="_blank" rel="noopener" class="text-brand-red hover:underline">{tool.name}</a></>}
                </div>
                {p.coverage && p.coverage.length > 0 && (
                  <div class="mt-1 text-sm text-ink/70 dark:text-cream/70">
                    Coverage: {p.coverage.map((c, i) => (
                      <>{i > 0 && <span>, </span>}<a href={c.url} target="_blank" rel="noopener" class="hover:underline">{c.outlet}</a></>
                    ))}
                  </div>
                )}
                <details class="mt-1.5 text-sm group">
                  <summary class="list-none cursor-pointer text-ink/55 dark:text-cream/55 hover:text-ink dark:hover:text-cream select-none">Abstract</summary>
                  <p class="mt-1.5 leading-relaxed text-ink/85 dark:text-cream/85">{p.blurb}</p>
                </details>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </article>
</Layout>
