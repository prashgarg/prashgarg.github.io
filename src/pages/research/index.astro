---
import Layout from '../../layouts/Win95Layout.astro';
import { papers, statusMeta, tools, type PaperStatus } from '../../data/site';

const order: PaperStatus[] = ['published', 'accepted', 'rr', 'working', 'other'];
const sectionTitles: Record<PaperStatus, string> = {
  published: 'Publications',
  accepted:  'Accepted',
  rr:        'Revise & Resubmit',
  working:   'Working papers',
  other:     'Essays & other writing',
};

const grouped = order.map(s => ({ status: s, items: papers.filter(p => p.status === s) }))
                     .filter(g => g.items.length > 0);
---
<Layout title="Research — Prashant Garg" current="research">
  <section class="border-b-2 border-ink dark:border-cream">
    <div class="max-w-6xl mx-auto px-4 pt-14 pb-8">
      <h1 class="font-display text-3xl md:text-4xl font-bold">Research</h1>

      <div class="mt-6 flex flex-wrap gap-2" id="filters">
        <button data-filter="all" class="btn btn-yellow text-sm">All ({papers.length})</button>
        {order.map(s => {
          const count = papers.filter(p => p.status === s).length;
          if (!count) return null;
          return <button data-filter={s} class="btn text-sm">{statusMeta[s].label} ({count})</button>
        })}
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 space-y-14">
    {grouped.map(group => (
      <div data-section={group.status}>
        <h2 class="font-display text-2xl md:text-3xl font-bold mb-5 flex items-center gap-3">
          <span class={`badge ${statusMeta[group.status].badge}`}>{statusMeta[group.status].label}</span>
          <span>{sectionTitles[group.status]}</span>
          <span class="text-ink/40 dark:text-cream/40 text-base font-normal">· {group.items.length}</span>
        </h2>

        <div class="space-y-4">
          {group.items.map(p => (
            <details id={p.slug} data-paper={p.status} class="card group [&_summary]:cursor-pointer">
              <summary class="list-none flex items-start gap-4">
                <div class="flex-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class={`badge ${statusMeta[p.status].badge}`}>{statusMeta[p.status].label}</span>
                    {p.venue && <span class="text-xs font-medium text-ink/60 dark:text-cream/60">{p.venue}{p.year ? ` · ${p.year}` : ''}</span>}
                  </div>
                  <h3 class="font-display font-bold text-lg md:text-xl mt-2">{p.title}</h3>
                  {p.coauthors.length > 0 && (
                    <div class="mt-1 text-sm text-ink/70 dark:text-cream/70">
                      with {p.coauthors.map((c, i) => (
                        <span><span class="font-medium">{c}</span>{i < p.coauthors.length - 1 ? ', ' : ''}</span>
                      ))}
                    </div>
                  )}
                </div>
                <span class="shrink-0 mt-1 w-7 h-7 inline-flex items-center justify-center rounded-md border-2 border-ink dark:border-cream bg-cream dark:bg-ink-2 transition-transform group-open:rotate-45">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
                </span>
              </summary>

              <div class="mt-5 pt-5 border-t border-ink/15 dark:border-cream/15">
                <p class="text-ink/85 dark:text-cream/85 leading-relaxed">{p.blurb}</p>

                <div class="mt-5">
                  <div class="text-xs font-bold uppercase tracking-wider text-ink/50 dark:text-cream/50 mb-2">Links</div>
                  <div class="flex flex-wrap gap-2">
                    {p.links.map(l => (
                      <a href={l.url} target="_blank" rel="noopener"
                         class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-md border-2 border-ink dark:border-cream bg-white dark:bg-ink-3 hover:bg-brand-yellow dark:hover:bg-brand-yellow dark:hover:text-ink transition-colors">
                        {l.label}
                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
                      </a>
                    ))}
                  </div>
                </div>

                {p.coverage && p.coverage.length > 0 && (
                  <div class="mt-5">
                    <div class="text-xs font-bold uppercase tracking-wider text-ink/50 dark:text-cream/50 mb-2">As seen in</div>
                    <div class="flex flex-wrap gap-2">
                      {p.coverage.map(c => (
                        <a href={c.url} target="_blank" rel="noopener" class="chip hover:bg-brand-yellow/60">{c.outlet}</a>
                      ))}
                    </div>
                  </div>
                )}

                {p.tools && p.tools.length > 0 && (() => {
                  const tool = tools.find(t => t.slug === p.tools![0]);
                  return tool ? (
                    <div class="mt-5">
                      <a href={tool.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-red hover:underline">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m12.728 0a8 8 0 11-11.314 11.314 8 8 0 0111.314-11.314z"/></svg>
                        Companion site · {tool.url.replace(/^https?:\/\//, '')} &rarr;
                      </a>
                    </div>
                  ) : null;
                })()}

                <div class="mt-5 pt-5 border-t border-ink/15 dark:border-cream/15">
                  <a href={`/research/${p.slug}`} class="inline-flex items-center gap-2 text-sm font-semibold hover:bg-brand-yellow/40 px-1">
                    Open full page
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>

<script is:inline>
  (function () {
    const buttons = document.querySelectorAll('[data-filter]');
    const papers  = document.querySelectorAll('[data-paper]');
    const sections = document.querySelectorAll('[data-section]');
    buttons.forEach(b => b.addEventListener('click', () => {
      const f = b.getAttribute('data-filter');
      buttons.forEach(x => { x.classList.remove('btn-yellow'); });
      b.classList.add('btn-yellow');
      papers.forEach(p => { p.style.display = (f === 'all' || p.getAttribute('data-paper') === f) ? '' : 'none'; });
      sections.forEach(s => {
        const status = s.getAttribute('data-section');
        s.style.display = (f === 'all' || status === f) ? '' : 'none';
      });
    }));

    // Open paper if URL hash matches
    if (location.hash) {
      const el = document.getElementById(location.hash.slice(1));
      if (el && el.tagName === 'DETAILS') el.setAttribute('open', '');
    }
  })();
</script>
