---
import Desktop from '../layouts/Desktop.astro';
import { site } from '../data/site';

const leftRail = [
  { href: '/research', title: 'research.md', label: 'Research',  icon: 'book',     window: true,  color: 'red'    },
  { href: '/talks',    title: 'talks.md',    label: 'Talks',     icon: 'mic',      window: true,  color: 'blue'   },
  { href: '/library',  title: 'library.md',  label: 'Library',   icon: 'archive',  window: true,  color: 'teal'   },
  { href: '/now',      title: 'now.md',      label: 'Now',       icon: 'clock',    window: true,  color: 'yellow' },
  { href: site.cv,     title: 'cv.pdf',      label: 'CV',        icon: 'file',     window: false, color: 'purple' },
];

const rightRail = [
  { href: `mailto:${site.email}`, label: 'Email',   icon: 'mail',     window: false, color: 'red'    },
  { href: site.scholar,           label: 'Scholar', icon: 'cap',      window: false, color: 'blue'   },
  { href: site.twitter,           label: 'Twitter', icon: 'twitter',  window: false, color: 'teal'   },
  { href: site.bluesky,           label: 'Bluesky', icon: 'bluesky',  window: false, color: 'yellow' },
  { href: site.github,            label: 'GitHub',  icon: 'github',   window: false, color: 'purple' },
];

// inline tile-icons (24x24 stroke style)
const icons: Record<string, string> = {
  book:    '<path d="M4 19V5a2 2 0 0 1 2-2h12v18H6a2 2 0 0 1-2-2zm0 0a2 2 0 0 1 2-2h12"/>',
  mic:     '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 1 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3M8 22h8"/>',
  archive: '<path d="M20 8H4v12h16V8zM2 4h20v4H2zM10 12h4"/>',
  clock:   '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  file:    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6"/>',
  mail:    '<path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><path d="M2 6l10 7 10-7"/>',
  cap:     '<path d="M22 10L12 4 2 10l10 6 10-6z"/><path d="M6 12v5c2 2 4 3 6 3s4-1 6-3v-5"/>',
  twitter: '<path d="M4 4l7 9-7 7h2.5L12 14.5 17 20h4l-7.5-9.5L20.5 4H18l-4.7 5.5L9 4z"/>',
  bluesky: '<path d="M7 4c2 1 4 4 5 7 1-3 3-6 5-7 3 0 4 3 3 6-1 2-3 3-4 4 2 0 4 1 4 3 0 2-2 3-4 2-1 0-2-1-4-3-2 2-3 3-4 3-2 1-4 0-4-2 0-2 2-3 4-3-1-1-3-2-4-4-1-3 0-6 3-6z"/>',
  github:  '<path d="M9 19c-4 1-4-2-6-2m12 5v-3a3 3 0 0 0-1-2c3 0 6-2 6-6 0-1 0-3-1-4 0-2 0-3-1-3 0 0-2 0-4 1-3-1-7-1-10 0-2-1-4-1-4-1-1 0-1 1-1 3-1 1-1 3-1 4 0 4 3 6 6 6a3 3 0 0 0-1 2v3"/>',
};

function svg(name: string) {
  return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${icons[name]}</svg>`;
}
---
<Desktop>
  <div class="desktop">
    <!-- left rail -->
    <aside class="rail rail-left">
      {leftRail.map(it => (
        <button class="tile" type="button"
                data-color={it.color}
                data-window={it.window ? it.href : ''}
                data-title={it.title}
                data-href={it.href}
                data-external={it.window ? '' : 'true'}>
          <span class="tile-icon" set:html={svg(it.icon)}></span>
          <span class="tile-label">{it.label}</span>
        </button>
      ))}
    </aside>

    <!-- main stage -->
    <main class="stage">
      <article class="window">
        <header class="window-bar">
          <span class="window-file">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
            <span class="window-title">about.md</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="window-chevron" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </span>
          <span class="window-controls" aria-hidden="true">
            <i class="ctl ctl-min" title="minimise"></i>
            <i class="ctl ctl-max" title="maximise"></i>
            <i class="ctl ctl-close" title="close"></i>
          </span>
        </header>

        <div class="window-body">
          <div class="bio-grid">
            <div class="bio-text">
              <h1>Prashant Garg</h1>
              <p>
                I'm an economist working on science, innovation, production,
                and media with machine learning, causal inference, and network
                science.
              </p>

              <div class="now-block">
                <div class="now-label">Now</div>
                <ul>
                  <li>Research Associate · <a href="https://www.econ.cam.ac.uk/" target="_blank" rel="noopener">Cambridge</a></li>
                  <li>Associate Fellow · <a href="https://www.inet.ox.ac.uk/" target="_blank" rel="noopener">INET Oxford</a></li>
                </ul>
                <div class="now-label next">From Sept 2026</div>
                <ul>
                  <li>Postdoctoral Researcher · <a href="https://www.unibocconi.it/en" target="_blank" rel="noopener">Bocconi</a></li>
                </ul>
              </div>

              <p class="hint">
                Click any icon on the rails to open it in a window.
              </p>
            </div>

            <div class="bio-photo">
              <img src="/photo.jpg" alt="Prashant Garg"
                   onerror="this.onerror=null;this.src='/photo.svg';" />
            </div>
          </div>

          <!-- Mobile-only dock: same actions as the rails on desktop -->
          <div id="mobile-dock">
            {[...leftRail, ...rightRail].map(it => (
              <button class="tile" type="button"
                      data-color={it.color}
                      data-window={it.window ? it.href : ''}
                      data-title={('title' in it ? it.title : '') as string}
                      data-href={it.href}>
                <span class="tile-icon" set:html={svg(it.icon)}></span>
                <span class="tile-label">{it.label}</span>
              </button>
            ))}
          </div>
        </div>
      </article>
    </main>

    <!-- right rail -->
    <aside class="rail rail-right">
      {rightRail.map(it => (
        <a class="tile" data-color={it.color} href={it.href} target="_blank" rel="noopener">
          <span class="tile-icon" set:html={svg(it.icon)}></span>
          <span class="tile-label">{it.label}</span>
        </a>
      ))}
    </aside>
  </div>

  <!-- mount point for opened windows -->
  <div id="window-host" aria-live="polite"></div>
</Desktop>

<style>
  body { overflow: auto; }

  .desktop {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) 96px;
    min-height: 100vh;
    align-items: start;
    gap: 0;
    padding: 24px 16px;
  }
  @media (max-width: 760px) {
    .desktop {
      grid-template-columns: 1fr;
      padding: 12px 8px;
      gap: 0;
    }
    .rail { display: none; }
  }

  .rail {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 12px;
  }

  /* Mobile dock — rendered inside the window on small screens */
  #mobile-dock { display: none; }
  @media (max-width: 760px) {
    #mobile-dock {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
      margin-top: 24px;
      padding-top: 18px;
      border-top: 1px dashed rgba(0,0,0,0.18);
    }
    html.dark #mobile-dock { border-top-color: rgba(255,255,255,0.18); }
    #mobile-dock .tile { width: auto; gap: 4px; padding: 6px 0; }
    #mobile-dock .tile-icon { width: 38px; height: 38px; border-radius: 8px; }
    #mobile-dock .tile-icon svg { width: 18px; height: 18px; }
    #mobile-dock .tile-label { font-size: 10px; }
  }

  .tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 72px;
    padding: 8px 4px;
    background: transparent;
    border: none;
    color: var(--color-ink);
    cursor: pointer;
    border-radius: 8px;
    transition: background 120ms ease, transform 120ms ease;
    text-decoration: none;
  }
  .tile:hover { background: rgba(0,0,0,0.06); transform: translateY(-1px); }
  html.dark .tile { color: var(--color-cream); }
  html.dark .tile:hover { background: rgba(255,255,255,0.06); }

  .tile-icon {
    width: 46px; height: 46px;
    display: flex; align-items: center; justify-content: center;
    background: #FAF6E9;
    border: 2px solid var(--color-ink);
    border-radius: 11px;
    box-shadow: 2px 2px 0 0 var(--color-ink),
                inset 0 2px 0 rgba(255,255,255,0.55),
                inset 0 -3px 0 rgba(0,0,0,0.08);
    transition: transform 90ms ease, box-shadow 90ms ease;
  }
  .tile-icon svg { width: 22px; height: 22px; color: var(--color-ink); }
  .tile:hover .tile-icon {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 0 var(--color-ink),
                inset 0 2px 0 rgba(255,255,255,0.55),
                inset 0 -3px 0 rgba(0,0,0,0.08);
  }
  .tile:active .tile-icon {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 0 var(--color-ink),
                inset 0 -2px 0 rgba(255,255,255,0.35),
                inset 0 2px 0 rgba(0,0,0,0.10);
  }

  /* Per-tile accent fills */
  .tile[data-color="red"]    .tile-icon { background: #F8B89A; }
  .tile[data-color="blue"]   .tile-icon { background: #B5C8FF; }
  .tile[data-color="yellow"] .tile-icon { background: #FBE08A; }
  .tile[data-color="teal"]   .tile-icon { background: #9AE5D2; }
  .tile[data-color="purple"] .tile-icon { background: #DDB4EE; }

  html.dark .tile-icon {
    background: var(--color-ink-3);
    border-color: var(--color-cream);
    color: var(--color-cream);
    box-shadow: 2px 2px 0 0 var(--color-cream),
                inset 0 2px 0 rgba(255,255,255,0.08),
                inset 0 -3px 0 rgba(0,0,0,0.25);
  }
  html.dark .tile:hover .tile-icon { box-shadow: 3px 3px 0 0 var(--color-cream),
                inset 0 2px 0 rgba(255,255,255,0.08),
                inset 0 -3px 0 rgba(0,0,0,0.25); }
  html.dark .tile:active .tile-icon { box-shadow: 1px 1px 0 0 var(--color-cream),
                inset 0 -2px 0 rgba(255,255,255,0.04),
                inset 0 2px 0 rgba(0,0,0,0.30); }
  html.dark .tile[data-color="red"]    .tile-icon { background: #6F2E1A; }
  html.dark .tile[data-color="blue"]   .tile-icon { background: #25356E; }
  html.dark .tile[data-color="yellow"] .tile-icon { background: #6F551A; }
  html.dark .tile[data-color="teal"]   .tile-icon { background: #1F5C50; }
  html.dark .tile[data-color="purple"] .tile-icon { background: #4E2766; }
  .tile-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-align: center;
    max-width: 72px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stage {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 32px 16px 16px;
  }
  @media (max-width: 760px) { .stage { padding: 8px 0 16px; } }

  .window {
    width: 100%;
    max-width: 760px;
    background: #FAF6E9;
    border: 2px solid var(--color-ink);
    border-radius: 12px;
    box-shadow: 6px 6px 0 0 var(--color-ink);
    overflow: hidden;
  }
  html.dark .window {
    background: var(--color-ink-3);
    border-color: var(--color-cream);
    box-shadow: 6px 6px 0 0 var(--color-cream);
  }

  .window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 36px;
    padding: 0 12px;
    background: #E3DCC7;
    border-bottom: 2px solid var(--color-ink);
  }
  html.dark .window-bar {
    background: #2A2724;
    border-bottom-color: var(--color-cream);
  }
  .window-file {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    background: #FAF6E9;
    border: 1.5px solid var(--color-ink);
    border-radius: 6px;
    box-shadow: 1px 1px 0 0 var(--color-ink);
  }
  html.dark .window-file {
    background: var(--color-ink-3);
    border-color: var(--color-cream);
    box-shadow: 1px 1px 0 0 var(--color-cream);
  }
  .window-file svg { width: 13px; height: 13px; color: var(--color-ink); }
  html.dark .window-file svg { color: var(--color-cream); }
  .window-chevron { opacity: 0.55; }

  .window-controls { display: inline-flex; gap: 8px; }
  .window-controls .ctl {
    width: 18px; height: 18px;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1.5px solid var(--color-ink);
    border-radius: 4px;
    background: #FAF6E9;
    box-shadow: 1px 1px 0 0 var(--color-ink);
    position: relative;
  }
  html.dark .window-controls .ctl {
    background: var(--color-ink-3);
    border-color: var(--color-cream);
    box-shadow: 1px 1px 0 0 var(--color-cream);
  }
  .window-controls .ctl::before,
  .window-controls .ctl::after {
    content: '';
    position: absolute;
    background: var(--color-ink);
  }
  html.dark .window-controls .ctl::before,
  html.dark .window-controls .ctl::after { background: var(--color-cream); }
  .window-controls .ctl-min::before { width: 8px; height: 1.5px; bottom: 4px; left: 4px; }
  .window-controls .ctl-max::before { width: 8px; height: 8px; top: 3px; left: 3px;
    background: transparent; border: 1.5px solid var(--color-ink);
  }
  html.dark .window-controls .ctl-max::before { border-color: var(--color-cream); background: transparent; }
  .window-controls .ctl-close::before,
  .window-controls .ctl-close::after { width: 11px; height: 1.5px; top: 8px; left: 2px; }
  .window-controls .ctl-close::before { transform: rotate(45deg); }
  .window-controls .ctl-close::after  { transform: rotate(-45deg); }
  .window-title {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    color: var(--color-ink);
  }
  html.dark .window-title { color: var(--color-cream); }

  .window-body { padding: 28px 32px 32px; }
  @media (max-width: 760px) { .window-body { padding: 20px; } }

  .bio-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  @media (max-width: 760px) {
    .bio-grid { grid-template-columns: 1fr; gap: 18px; }
    .bio-photo { order: -1; max-width: 200px; margin: 0 auto; }
  }

  .bio-text h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 0 0 16px;
  }
  .bio-text p {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(20,17,13,0.85);
    margin: 0 0 16px;
  }
  html.dark .bio-text p { color: rgba(238,239,233,0.85); }

  .now-block {
    margin: 20px 0 16px;
    padding: 14px 16px;
    background: rgba(0,0,0,0.04);
    border: 1px dashed rgba(0,0,0,0.18);
    border-radius: 8px;
    font-size: 14px;
  }
  html.dark .now-block {
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.18);
  }
  .now-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-brand-red);
    margin-bottom: 4px;
  }
  .now-label.next { color: var(--color-brand-blue); margin-top: 12px; }
  .now-block ul { list-style: none; padding: 0; margin: 0; }
  .now-block li { padding: 2px 0; }
  .now-block a { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; text-decoration-color: var(--color-brand-red); }

  .hint {
    font-size: 12px !important;
    color: rgba(20,17,13,0.5) !important;
    font-style: italic;
    margin-top: 12px !important;
  }
  html.dark .hint { color: rgba(238,239,233,0.5) !important; }

  .bio-photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    border: 2px solid var(--color-ink);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 4px 4px 0 0 var(--color-ink);
    background: #E8E0CB;
  }
  html.dark .bio-photo { border-color: var(--color-cream); box-shadow: 4px 4px 0 0 var(--color-cream); }
  .bio-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; display: block; }

  /* Opened windows (popups) */
  #window-host {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 50;
  }
  @keyframes window-in {
    0%   { opacity: 0; transform: scale(0.94) translateY(6px); }
    60%  { opacity: 1; transform: scale(1.01) translateY(0); }
    100% { opacity: 1; transform: scale(1)    translateY(0); }
  }
  @keyframes window-out {
    0%   { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(0.96) translateY(4px); }
  }
  .popup {
    position: absolute;
    background: #FAF6E9;
    border: 2px solid var(--color-ink);
    border-radius: 12px;
    box-shadow: 8px 8px 0 0 var(--color-ink);
    pointer-events: auto;
    max-width: min(900px, calc(100vw - 48px));
    max-height: calc(100vh - 96px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform-origin: top center;
    animation: window-in 220ms cubic-bezier(0.34, 1.4, 0.4, 1);
  }
  .popup.closing { animation: window-out 160ms ease-in forwards; }
  html.dark .popup {
    background: var(--color-ink-3);
    border-color: var(--color-cream);
    box-shadow: 8px 8px 0 0 var(--color-cream);
  }
  .popup .popup-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    height: 36px;
    padding: 0 10px;
    background: #E3DCC7;
    border-bottom: 2px solid var(--color-ink);
    cursor: grab;
    user-select: none;
  }
  html.dark .popup .popup-bar {
    background: #2A2724;
    border-bottom-color: var(--color-cream);
  }
  .popup .popup-bar.dragging { cursor: grabbing; }
  .popup .popup-file {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    background: #FAF6E9;
    border: 1.5px solid var(--color-ink);
    border-radius: 6px;
    box-shadow: 1px 1px 0 0 var(--color-ink);
  }
  html.dark .popup .popup-file {
    background: var(--color-ink-3);
    border-color: var(--color-cream);
    box-shadow: 1px 1px 0 0 var(--color-cream);
  }
  .popup .popup-file svg { width: 13px; height: 13px; color: var(--color-ink); }
  html.dark .popup .popup-file svg { color: var(--color-cream); }
  .popup .popup-title {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
  }
  .popup .popup-controls { display: inline-flex; align-items: center; gap: 8px; }
  .popup .popup-open {
    font-size: 11px;
    color: rgba(20,17,13,0.6);
    text-decoration: underline;
    margin-right: 4px;
  }
  html.dark .popup .popup-open { color: rgba(238,239,233,0.6); }
  .popup .ctl {
    width: 18px; height: 18px;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1.5px solid var(--color-ink);
    border-radius: 4px;
    background: #FAF6E9;
    box-shadow: 1px 1px 0 0 var(--color-ink);
    position: relative;
    cursor: pointer;
  }
  html.dark .popup .ctl {
    background: var(--color-ink-3);
    border-color: var(--color-cream);
    box-shadow: 1px 1px 0 0 var(--color-cream);
  }
  .popup .ctl:hover { transform: translate(-0.5px, -0.5px); }
  .popup .ctl:active { transform: translate(0.5px, 0.5px); box-shadow: 0 0 0 0 var(--color-ink); }
  .popup .ctl::before,
  .popup .ctl::after { content: ''; position: absolute; background: var(--color-ink); }
  html.dark .popup .ctl::before,
  html.dark .popup .ctl::after { background: var(--color-cream); }
  .popup .ctl-min::before { width: 8px; height: 1.5px; bottom: 4px; left: 4px; }
  .popup .ctl-max::before { width: 8px; height: 8px; top: 3px; left: 3px;
    background: transparent; border: 1.5px solid var(--color-ink); }
  html.dark .popup .ctl-max::before { border-color: var(--color-cream); background: transparent; }
  .popup .ctl-close::before,
  .popup .ctl-close::after { width: 11px; height: 1.5px; top: 8px; left: 2px; }
  .popup .ctl-close::before { transform: rotate(45deg); }
  .popup .ctl-close::after  { transform: rotate(-45deg); }
  .popup .popup-body {
    padding: 20px 24px 24px;
    overflow-y: auto;
    background: #FAF6E9;
  }
  html.dark .popup .popup-body { background: var(--color-ink-3); }
</style>

<script is:inline>
  (function () {
    const saved = localStorage.getItem('theme');
    if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    }

    const host = document.getElementById('window-host');
    let zCounter = 60;
    let offset = 0;

    function clampPos(left, top, width, height) {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const maxLeft = Math.max(8, vw - width - 8);
      const maxTop  = Math.max(8, vh - 48); // keep title bar visible
      return {
        left: Math.max(8, Math.min(maxLeft, left)),
        top:  Math.max(8, Math.min(maxTop,  top)),
      };
    }

    function makeWindow(html, title, href) {
      offset = (offset + 28) % 200;
      const w = document.createElement('div');
      w.className = 'popup';
      const vw = window.innerWidth;
      const desiredW = Math.min(760, vw - 32);
      const desiredLeft = Math.max(8, (vw - desiredW) / 2 + offset - 40);
      const desiredTop = 60 + offset;
      const clamped = clampPos(desiredLeft, desiredTop, desiredW, 400);
      w.style.top = clamped.top + 'px';
      w.style.left = clamped.left + 'px';
      w.style.width = desiredW + 'px';
      w.style.zIndex = ++zCounter;
      w.innerHTML = `
        <header class="popup-bar">
          <span class="popup-file">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
            <span class="popup-title">${title}</span>
          </span>
          <span class="popup-controls">
            <a class="popup-open" href="${href}" title="Open as page" target="_self">open</a>
            <i class="ctl ctl-min" title="minimise" data-act="min"></i>
            <i class="ctl ctl-max" title="maximise" data-act="max"></i>
            <i class="ctl ctl-close" title="close" data-act="close"></i>
          </span>
        </header>
        <div class="popup-body"></div>
      `;
      w.querySelector('.popup-body').innerHTML = html;
      w.addEventListener('mousedown', () => { w.style.zIndex = ++zCounter; });
      // close with closing animation
      w.querySelector('[data-act=close]').addEventListener('click', () => {
        w.classList.add('closing');
        w.addEventListener('animationend', () => w.remove(), { once: true });
      });
      // minimise: slide down + fade
      w.querySelector('[data-act=min]').addEventListener('click', () => {
        w.classList.add('closing');
        w.addEventListener('animationend', () => w.remove(), { once: true });
      });
      // maximise: expand to fill the viewport
      w.querySelector('[data-act=max]').addEventListener('click', () => {
        const max = w.classList.toggle('maxed');
        if (max) {
          w.dataset.prev = JSON.stringify({
            left: w.style.left, top: w.style.top, width: w.style.width
          });
          w.style.left = '12px';
          w.style.top = '12px';
          w.style.width = (window.innerWidth - 24) + 'px';
        } else if (w.dataset.prev) {
          const p = JSON.parse(w.dataset.prev);
          w.style.left = p.left; w.style.top = p.top; w.style.width = p.width;
        }
      });
      // basic drag
      const bar = w.querySelector('.popup-bar');
      let dragging = false, sx = 0, sy = 0, ox = 0, oy = 0;
      bar.addEventListener('mousedown', (e) => {
        if (e.target.closest('[data-act], a')) return;
        dragging = true; bar.classList.add('dragging');
        sx = e.clientX; sy = e.clientY;
        const r = w.getBoundingClientRect();
        ox = r.left; oy = r.top;
        w.style.left = ox + 'px';
        w.style.top  = oy + 'px';
      });
      document.addEventListener('mousemove', (e) => {
        if (!dragging) return;
        const c = clampPos(ox + e.clientX - sx, oy + e.clientY - sy, w.offsetWidth, w.offsetHeight);
        w.style.left = c.left + 'px';
        w.style.top  = c.top  + 'px';
      });
      document.addEventListener('mouseup', () => { dragging = false; bar.classList.remove('dragging'); });
      host.appendChild(w);
    }

    async function openPath(href, title) {
      try {
        const res = await fetch(href);
        const txt = await res.text();
        const doc = new DOMParser().parseFromString(txt, 'text/html');
        const main = doc.querySelector('main') || doc.body;
        // Remove scripts from the cloned content; we'll re-create them after mount
        const scripts = Array.from(main.querySelectorAll('script'));
        scripts.forEach(s => s.remove());
        makeWindow(main.innerHTML, title, href);
        const popup = host.lastElementChild;
        const body = popup.querySelector('.popup-body');
        // Recreate scripts so they actually execute
        scripts.forEach(oldScript => {
          const s = document.createElement('script');
          for (const a of oldScript.attributes) s.setAttribute(a.name, a.value);
          s.textContent = oldScript.textContent;
          body.appendChild(s);
        });
      } catch (e) {
        location.href = href;
      }
    }

    document.querySelectorAll('.tile').forEach(el => {
      el.addEventListener('click', (e) => {
        const path = el.dataset.window;
        const href = el.dataset.href;
        const title = el.dataset.title || el.textContent.trim();
        if (!path) {
          // external — let the anchor or open default
          if (el.tagName === 'A') return;
          window.open(href, '_blank', 'noopener');
          return;
        }
        e.preventDefault();
        openPath(path, title);
      });
    });
  })();
</script>
