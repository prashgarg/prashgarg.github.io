---
import Layout from '../layouts/Layout.astro';
import { site, papers, statusMeta } from '../data/site';

const recentPapers = papers.slice(0, 4);
---
<Layout current="home">
  <!-- HERO -->
  <section class="border-b-2 border-ink dark:border-cream">
    <div class="max-w-4xl mx-auto px-4 pt-20 pb-20 grid md:grid-cols-5 gap-10 items-start">
      <div class="md:col-span-3 space-y-6">
        <h1 class="font-display text-5xl sm:text-6xl font-bold leading-[1.05] tracking-tight">
          Prashant Garg
        </h1>
        <p class="text-base md:text-lg leading-relaxed text-ink/85 dark:text-cream/85">
          I'm an economist working on science, innovation, production, and
          media with machine learning, causal inference, and network science.
        </p>
      </div>

      <aside class="md:col-span-2">
        <div class="card text-sm">
          <div class="text-[11px] font-bold uppercase tracking-wider text-brand-red mb-2">Now</div>
          <ul class="space-y-1">
            <li>Research Associate · <a class="link" href="https://www.econ.cam.ac.uk/" target="_blank" rel="noopener">Cambridge</a></li>
            <li>Associate Fellow · <a class="link" href="https://www.inet.ox.ac.uk/" target="_blank" rel="noopener">INET Oxford</a></li>
          </ul>
          <div class="text-[11px] font-bold uppercase tracking-wider text-brand-blue mt-4 mb-2">From Sept 2026</div>
          <ul class="space-y-1">
            <li>Postdoctoral Researcher · <a class="link" href="https://www.unibocconi.it/en" target="_blank" rel="noopener">Bocconi</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <!-- RECENT -->
  <section>
    <div class="max-w-4xl mx-auto px-4 py-14">
      <div class="text-xs font-bold uppercase tracking-wider text-brand-red mb-4">Recent</div>
      <ul class="divide-y divide-ink/15 dark:divide-cream/15 border-y border-ink/15 dark:border-cream/15">
        {recentPapers.map(p => (
          <li>
            <a href={`/research/${p.slug}`} class="block py-4 -mx-2 px-2 rounded hover:bg-brand-yellow/25 transition-colors">
              <div class="text-xs text-ink/55 dark:text-cream/55">
                {statusMeta[p.status].label}{p.venue ? ` · ${p.venue}` : ''}{p.year ? ` · ${p.year}` : ''}
              </div>
              <div class="font-display font-semibold mt-1 text-lg leading-snug">{p.title}</div>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-4">
        <a href="/research" class="text-sm font-semibold underline decoration-2 decoration-brand-red underline-offset-4 hover:bg-brand-yellow/40 px-1">All research &rarr;</a>
      </div>
    </div>
  </section>
</Layout>
